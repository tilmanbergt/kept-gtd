{
  "startOnLoad": false,
  "theme": "base",
  "securityLevel": "strict",
  "fontFamily": "Archivo, sans-serif",
  "themeVariables": {
    "fontFamily": "Archivo, sans-serif",
    "fontSize": "28px",
    "background": "#ffffff",
    "primaryColor": "#ffffff",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#000000",
    "secondaryColor": "#eeeeee",
    "secondaryTextColor": "#000000",
    "secondaryBorderColor": "#888888",
    "tertiaryColor": "#ffffff",
    "tertiaryTextColor": "#000000",
    "tertiaryBorderColor": "#888888",
    "lineColor": "#000000",
    "textColor": "#000000",
    "mainBkg": "#ffffff",
    "nodeBorder": "#000000",
    "clusterBkg": "#f4f4f4",
    "clusterBorder": "#888888",
    "titleColor": "#000000",
    "edgeLabelBackground": "#ffffff",
    "labelBackground": "#ffffff",
    "noteBkgColor": "#eeeeee",
    "noteBorderColor": "#888888",
    "noteTextColor": "#000000"
  },
  "themeCSS": ".node rect, .node polygon, .node circle, .node path { stroke-width: 3px; } .flowchart-link, .edgePath path, .transition { stroke-width: 3px; } .marker { stroke-width: 1px; } .cluster rect { stroke-width: 2px; } .edgeLabel, .edgeLabel p { font-size: 24px; } .statediagram-state rect.basic, .statediagram-state rect.divider { stroke-width: 3px; }",
  "flowchart": {"htmlLabels": true, "curve": "linear", "nodeSpacing": 40, "rankSpacing": 60, "padding": 16, "useMaxWidth": false},
  "state": {"useMaxWidth": false}
}
